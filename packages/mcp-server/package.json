{
  "name": "agent-gauge-mcp",
  "version": "1.0.0",
  "description": "MCP Server & CLI for AgentGauge: <15ms deterministic model/effort routing and closed-loop git diff survival telemetry.",
  "type": "module",
  "bin": {
    "agent-gauge": "./src/cli.ts",
    "agent-gauge-mcp": "./src/index.ts",
    "gauge": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json || node -e \"console.log('agent-gauge-mcp ready')\"",
    "start": "node --experimental-strip-types ./src/index.ts",
    "cli": "node --experimental-strip-types ./src/cli.ts"
  },
  "dependencies": {
    "@agent-gauge/core-scorer": "*",
    "@modelcontextprotocol/sdk": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}

